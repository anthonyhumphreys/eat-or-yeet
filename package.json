{
  "name": "eat-or-yeet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "predev": "pnpm build:mcp-app",
    "dev:app": "tsx scripts/dev.ts --app",
    "dev:web": "next dev",
    "build": "next build",
    "prebuild": "pnpm build:mcp-app",
    "build:mcp-app": "tsx scripts/build-mcp-app.ts",
    "package:plugin": "tsx scripts/package-plugin.ts",
    "package:plugin:grok-bot": "tsx scripts/package-grok-bot-plugin.ts",
    "build:vercel": "pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "pnpm build:mcp-app",
    "pretest:e2e": "pnpm build:mcp-app",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "playwright test --config playwright.fixture.config.ts",
    "test:mcp": "tsx scripts/mcp-smoke.ts",
    "data:seed": "tsx --env-file=.env.local --env-file-if-exists=.env.development.local scripts/seed.ts",
    "data:sync:fsis": "tsx scripts/sync-fsis.ts",
    "backend:generate": "tsx scripts/generate-backend.ts",
    "backend:types": "tsx scripts/backend-types.ts",
    "backend:dev": "wrangler dev --local",
    "backend:deploy:staging": "wrangler deploy --env staging",
    "backend:deploy:production": "wrangler deploy --env production",
    "backend:migrate:local": "wrangler d1 migrations apply DB --local",
    "backend:restore": "tsx scripts/restore-backend.ts",
    "backend:run": "tsx scripts/backend-run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@next/env": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "fflate": "0.8.3",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@10.32.1"
}
