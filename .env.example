# Convex deployment and server-to-server mutation signing.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SERVER_SECRET=

# Scheduled ingestion.
CRON_SECRET=

# Used to hash anonymous rate-limit identifiers. Keep this secret.
RATE_LIMIT_SALT=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local seed guard. Never enable this in production.
ALLOW_DEMO_DATA=true
