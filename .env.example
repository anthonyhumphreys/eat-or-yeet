# Cloudflare backend. These values stay on the server.
BACKEND_ENV=local
BACKEND_URL=http://127.0.0.1:8787
BACKEND_SECRET=
# Local/operator tools only. Never set these upload/operator tokens in Vercel.
BACKEND_ADMIN_TOKEN=
FSIS_UPLOAD_TOKEN=
FDA_UPLOAD_TOKEN=

# Scheduled ingestion.
CRON_SECRET=
# Optional openFDA key, set on the Cloudflare Worker deployment. Without one openFDA allows
# 1,000 requests a day per IP address. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Optional FDA announcement detail-page retrieval. Provider APIs and the full
# FDA listing keep their existing transport. Keep direct until live evaluation.
FDA_ANNOUNCEMENTS_DETAIL_FETCH_MODE=direct
FIRECRAWL_API_KEY=

# Used to hash anonymous rate-limit identifiers. Keep this secret.
RATE_LIMIT_SALT=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted read-only MCP pilot. Disabled unless explicitly true.
MCP_ENABLED=false
# Additional browser origins allowed to call MCP. Comma-separated HTTPS origins.
# Server-to-server MCP clients normally send no Origin header.
MCP_ALLOWED_ORIGINS=
# Private, bearer-authenticated Notion shopping MCP. Keep both disabled unless
# keys are provisioned. MCP_CONNECTION_KEYS is a JSON array of 1-20 entries:
# {"id":"safe-id","sha256":"64 hex chars","dailyLimit":40,"expiresAt":"2099-01-01T00:00:00.000Z"}.
# Store SHA-256 hashes only; never commit bearer tokens. Daily limits are shared
# across private tools; shopping review charges one unit per submitted item.
MCP_NOTION_ENABLED=false
MCP_CONNECTION_KEYS=

# Hosted Notion installation. Existing Vercel API + Cloudflare Worker; default off until live acceptance.
NOTION_INSTALL_ENABLED=false
# Private OAuth/webhook settings in Vercel. Client credentials also go in Cloudflare Worker for refresh/revoke.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_INTEGRATION_ID=
NOTION_SUBSCRIPTION_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Temporary operator-only verification capture; leave blank during normal operation.
# Public RSA PEM only. Expiry is a Unix timestamp in milliseconds, at most 15 minutes ahead.
NOTION_WEBHOOK_SETUP_PUBLIC_KEY=
NOTION_WEBHOOK_SETUP_EXPIRES_AT=
# Private base64-encoded 32-byte encryption key, identical in Vercel and Cloudflare Worker.
NOTION_CREDENTIAL_KEY=
# Cloudflare Worker only: operator bearer token for the existing private /mcp/notion route.
NOTION_REVIEW_CONNECTION_KEY=

# Local seed guard. Never enable this in production.
ALLOW_DEMO_DATA=true

# Optional, explicit analytics. Keep off locally and in previews.
POSTHOG_ENABLED=false
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_TOKEN=
