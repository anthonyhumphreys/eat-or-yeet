# Convex deployment and server-to-server mutation signing.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SERVER_SECRET=

# Scheduled ingestion.
CRON_SECRET=

# Used to hash anonymous rate-limit identifiers. Keep this secret.
RATE_LIMIT_SALT=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted read-only MCP pilot. Disabled unless explicitly true.
MCP_ENABLED=false
# Additional browser origins allowed to call MCP. Comma-separated HTTPS origins.
# Server-to-server MCP clients normally send no Origin header.
MCP_ALLOWED_ORIGINS=
# Private, bearer-authenticated Notion shopping MCP. Keep both disabled unless
# keys are provisioned. MCP_CONNECTION_KEYS is a JSON array of 1-20 entries:
# {"id":"safe-id","sha256":"64 hex chars","dailyLimit":40,"expiresAt":"2099-01-01T00:00:00.000Z"}.
# Store SHA-256 hashes only; never commit bearer tokens. Daily limits are shared
# across private tools; shopping review charges one unit per submitted item.
MCP_NOTION_ENABLED=false
MCP_CONNECTION_KEYS=

# Local seed guard. Never enable this in production.
ALLOW_DEMO_DATA=true
